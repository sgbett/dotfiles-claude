#!/bin/sh
# usage: ruby-launch ENTRY [ARGUMENT ...]
#
# Runs a skill's Ruby entry file on this repository's Ruby. Claude Code's PATH
# carries the Ruby of whichever directory it started in, possibly an old one,
# and that directory's RUBYOPT, RUBYLIB, gem paths or Gemfile can load Bundler
# or shadow the standard library in any Ruby started there.

unset CDPATH # a CDPATH match makes cd print the directory it chose
if [ "$#" -lt 1 ]; then
  echo "ruby-launch: tool failure: no entry file given" >&2
  exit 1
fi
entry=$1
shift
case $entry in
  -*)
    echo "ruby-launch: tool failure: the entry file must be a path, not an option" >&2
    exit 1
    ;;
esac

here=$(cd -P -- "$(dirname -- "$0")" && pwd) || exit 1
# mise picks the Ruby that .ruby-version pins for the directory it runs in,
# reading only config and tool-versions files of these names, and no
# environment's or platform's mise.<name>.toml, so that /do's scripts digest
# (ScriptsCheckout::RUBY_FILES, held in step by its spec) covers every file
# that can pick another Ruby.
ruby=$(cd "$here" && MISE_OVERRIDE_CONFIG_FILENAMES='mise.toml:.mise.toml' \
  MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES='.tool-versions' MISE_ENV='' MISE_AUTO_ENV=false \
  mise which ruby 2>/dev/null) || ruby=ruby
[ -n "$ruby" ] || ruby=ruby
exec env -u RUBYOPT -u RUBYLIB -u GEM_HOME -u GEM_PATH -u BUNDLE_GEMFILE \
  "$ruby" --disable=rubyopt "$entry" "$@"
