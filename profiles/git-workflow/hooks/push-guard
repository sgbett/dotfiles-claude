#!/bin/sh
# vendored from sgbett/dotfiles-claude profiles/git-workflow/hooks/push-guard
# A PreToolUse hook on Bash: it denies a bare force-push and any rewrite or
# deletion of a base branch, asks before a lease push over another author's
# commits, and never answers allow. It reads the literal Bash text: a push
# inside a script, Makefile or alias is invisible, so the ruleset is the control.
input=$(cat)
case $input in
  *push*) ;;
  *) exit 0 ;;
esac
ask() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"push-guard: %s, so the push could not be checked"}}\n' "$1"
}
if ! command -v ruby >/dev/null 2>&1; then
  ask 'ruby is not installed'
  exit 0
fi
# A ruby that cannot start (a version manager's shim with nothing behind it)
# exits non-zero saying nothing, and Claude Code then lets the tool proceed.
if ! output=$(printf '%s' "$input" | ruby "$(dirname -- "$0")/push-guard.rb"); then
  output=$(ask 'ruby failed')
fi
[ -z "$output" ] || printf '%s\n' "$output"
exit 0
