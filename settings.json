{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "promptSuggestionEnabled": false,
  "spinnerTipsEnabled": false,
  "permissions": {
    "allow": [

      "Read",
      "Glob",
      "Grep",
      "WebFetch",

      "Bash(sed -f /tmp/*)",
      "Edit(/**)",
      "Write(/**)",

      "Skill",
      "ToolSearch",
      "EnterWorktree",

      "TaskCreate",
      "TaskGet",
      "TaskUpdate",
      "TaskList",

      "TeamCreate",
      "TeamDelete",
      "SendMessage",

      "Bash(awk *)",
      "Bash(curl *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",

      "Bash(rubocop *)",

      "Bash(git diff *)",
      "Bash(git show *)",

      "Bash(gh help *)",
      "Bash(gh org *)",
      "Bash(gh search *)",
      "Bash(gh status *)",

      "Bash(gh label *)",
      "Bash(gh api graphql *)",

      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh issue view *)",

      "Bash(gh pr checks *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr view *)",

      "Bash(gh project edit *)",
      "Bash(gh project field-*)",
      "Bash(gh project item-*)",
      "Bash(gh project list)",
      "Bash(gh project view *)",

      "Bash(gh repo view *)",

      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",

      "mcp__ruby-fetch__fetch_url",
      "mcp__bsv-protocol-docs__searchDocumentation"
    ],

    "ask": [
      "Bash(gh issue delete *)",
      "Bash(gh project item-delete *)",
      "Bash(gh run cancel *)",
      "Bash(gh run rerun *)"
    ],

    "deny": [
      "Bash(gh pr revert *)",
      "Bash(gh project delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh run delete *)"
    ]

  }
}
